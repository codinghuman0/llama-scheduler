#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0
"""Detect/recommend/validate Intel Hybrid proposals without privileged execution."""
import argparse
import json
from pathlib import Path
import sys
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
import collect
import profiles


def render(value):
    if 'cpu_mapping' in value:
        lines = [value['status'], 'CPU: ' + value['cpu_model'],
                 f"Available P={value['available_p_cores']} E={value['available_e_cores']} physical={value['available_physical_cores']}",
                 f"Compute={value['compute_threads']} Batch={value['batch_threads']} HTTP={value['http_threads']}",
                 'Affinity: ' + value['cpu_affinity'] + ' mask=' + value['affinity_mask_hex'],
                 'P representatives: ' + str(value['p_representatives']), 'E selection: ' + str(value['selected_e_cpus']),
                 'L2 placement: ' + value['e_placement_effective'], 'L2 groups: ' + json.dumps(value['selected_e_l2_groups']),
                 'Mapping: ' + json.dumps(value['cpu_mapping']),
                 'performance_validated=false; execution_admitted=false; TEAM_CPU_RUNTIME_NOT_TESTED']
        lines.extend(value['unverified_assumptions'])
        return '\n'.join(lines)
    return json.dumps(value, indent=2, ensure_ascii=False, allow_nan=False)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    subs = parser.add_subparsers(dest='command', required=True)
    for command in ['detect', 'recommend', 'validate', 'experiments', 'environment']:
        p = subs.add_parser(command)
        p.add_argument('--format', choices=['text','json'], default='text')
        p.add_argument('--output', type=Path, help='New output only; refuses existing files')
        if command != 'environment':
            p.add_argument('--probe', type=Path, required=True)
            p.add_argument('--cpus', help='Optional additional restriction within current allowed CPUs')
        if command == 'recommend':
            p.add_argument('--placement', choices=['compact','spread','lowest'], default='compact')
        if command == 'validate':
            p.add_argument('--config', type=Path, required=True)
        if command == 'experiments':
            p.add_argument('--expect-p', type=int)
            p.add_argument('--expect-e', type=int)
    args = parser.parse_args()
    try:
        config = json.loads(args.config.read_text()) if args.command == 'validate' else None
        if args.command == 'environment':
            value = collect.environment()
        else:
            requested = collect.portable.cpulist(args.cpus) if args.cpus is not None else config['requested_cpus'] if config else None
            detected = collect.inspect(args.probe, requested)
            if args.command == 'detect':
                value = detected
            elif args.command == 'recommend':
                value = profiles.recommend(detected, args.placement)
            elif args.command == 'validate':
                value = profiles.validate(config, detected)
            else:
                value = profiles.experiments(detected, args.expect_p, args.expect_e)
        text = json.dumps(value, indent=2, sort_keys=True, ensure_ascii=False, allow_nan=False) if args.format == 'json' else render(value)
        if args.output:
            with args.output.open('x') as stream:
                stream.write(text + '\n')
        else:
            print(text)
        return 0
    except (ValueError, OSError, KeyError, TypeError) as error:
        print(json.dumps(dict(status='AUTO_CONFIGURATION_BLOCKED', error=str(error), fallback='Keep the unchanged conservative Portable path for verified homogeneous CPUs; otherwise manual topology review. No forced P/E formula.', execution_admitted=False, performance_validated=False)), file=sys.stderr)
        return 2


if __name__ == '__main__':
    raise SystemExit(main())
